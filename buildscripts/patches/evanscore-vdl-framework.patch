diff --git a/framework/mpe/percussionsource.h b/framework/mpe/percussionsource.h
new file mode 100644
index 000000000..f87106f66
--- /dev/null
+++ b/framework/mpe/percussionsource.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-3.0-only; MuseScore-Studio-CLA-applies */
+#pragma once
+#include <algorithm>
+#include <cctype>
+#include <string>
+#include <string_view>
+
+namespace muse::mpe {
+struct PercussionSource {
+    bool present = false;
+    std::string instrument;
+    std::string sound;
+    int hand = 0; // 0 unspecified, 1 right, 2 left; never infer alternation.
+    int zone = 0; // 0 center, 1 halfway, 2 edge.
+    bool snaresOff = false;
+    bool solo = false;
+    bool operator==(const PercussionSource&) const = default;
+};
+inline std::string percussionToken(std::string_view text)
+{
+    std::string result;
+    for (unsigned char c : text) {
+        if (std::isalnum(c)) result += char(std::tolower(c));
+    }
+    return result;
+}
+struct VdlRoute {
+    int pitch = -1;
+    int modulation = -1;
+    std::string diagnostic;
+    bool supported() const { return pitch >= 0 && pitch <= 127; }
+};
+inline VdlRoute snareLineManualRoute(const PercussionSource& source)
+{
+    if (!source.present || source.instrument != "marching-snare") return {-1, -1, "SnareLine Manual mapping requires a marching-snare instrument."};
+    if (source.hand < 0) return {-1, -1, "Conflicting or multi-stroke sticking needs an explicit per-attack assignment."};
+    const bool left = source.hand == 2;
+    const auto sound = percussionToken(source.sound);
+    int pitch = -1;
+    if (sound == "batterysnare" || sound == "snare" || sound == "snarehit" || sound == "snaredrum" || sound == "hit")
+        pitch = source.snaresOff ? (left ? 102 : 104) : source.solo ? (left ? 61 : 63) : (left ? 78 : 80);
+    else if (sound == "rimshot" || sound == "shot")
+        pitch = source.snaresOff ? (left ? 101 : 103) : source.solo ? (left ? 62 : 64) : (left ? 77 : 79);
+    else if (sound == "rimclick" || sound == "rim") {
+        if (source.snaresOff || source.solo) return {-1, -1, "The selected rim sound has no verified equivalent in this variant."};
+        pitch = left ? 73 : 75;
+    } else if (sound == "backstick") {
+        if (source.snaresOff || source.solo) return {-1, -1, "Backstick variant is not documented for this mode."};
+        pitch = left ? 82 : 83;
+    }
+    if (pitch < 0) return {-1, -1, "No reviewed SnareLine Manual equivalent for source sound: " + source.sound};
+    const int cc = source.zone == 2 ? 110 : source.zone == 1 ? 65 : 0;
+    return {pitch, cc, source.hand == 0 ? "No written hand: using the right-hand sample, without invented alternation." : "Explicit written hand retained."};
+}
+}
